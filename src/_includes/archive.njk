---
layout: base.njk
plain: true
---
{% from "cover.njk" import cover %}
{% set shelf %}
<div class="ctl" hidden>
<label class="srch"><span>Search the archive</span><input type="search" placeholder="Title or author"></label>
<div class="chips" role="group" aria-label="Folders">
<button type="button" class="chip" data-folder="recommended" aria-pressed="true">Recommended</button>
<button type="button" class="chip" data-folder="all" aria-pressed="false">All</button>
{%- for f in archive.folders | usedFolders(collections.books) %}
<button type="button" class="chip" data-folder="{{ f.slug }}" aria-pressed="false">{{ f.title }}</button>
{%- endfor %}
</div>
<p class="count" aria-live="polite"></p>
</div>
<div class="shelf" id="shelf">
{%- for b in collections.books %}
{%- set fo = b.data.folder | folderInfo(archive.folders) %}
<a class="bk" href="{{ b.url | url }}" aria-label="{{ b.data.title }}, by {{ b.data.author }}" data-folder="{{ b.data.folder }}" data-rec="{% if b.data.recommended %}1{% else %}0{% endif %}" data-search="{{ (b.data.title ~ ' ' ~ b.data.author ~ ' ' ~ (b.data.items | itemText)) | plain }}">
{{ cover(b.data.title, b.data.author, fo.tone, "", "", b.data.cover_image | coverFile, b.data.collection) }}
<span class="fm">{% if b.data.collection %}Collection · {{ b.data.items | length }} books{% elif b.data.available %}{{ b.data.available }}{% else %}{% for f in b.data.formats %}{{ f.name }}{% if not loop.last %} · {% endif %}{% endfor %}{% endif %}{% if b.data.pending %} · file soon{% endif %}</span>
</a>
{%- endfor %}
</div>
<p class="none" hidden>No books match.</p>
{% endset %}
<div class="page archive-page">
{% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
<h1>{{ title }}</h1>
{% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
{{ "D3-B" | ornament("orn-d3b orn-title") | safe }}
<div class="page-body">
{{ content | replace("<!--shelf-->", shelf) | safe }}
</div>
{{ "O2" | ornament("orn-o2 orn-end") | safe }}
</div>
<script src="{{ '/assets/archive.js' | url }}" defer></script>
