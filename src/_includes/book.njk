---
layout: base.njk
plain: true
---
{% from "cover.njk" import cover %}
{% set fo = folder | folderInfo(archive.folders) %}
<div class="page book-page">
<p class="eyebrow"><a href="{{ '/resources/archive/' | url }}">Dhamma-Dana Archive</a></p>
{% if sample %}<p class="sample">SAMPLE ENTRY — not a real book. Delete before publishing.</p>{% endif %}
<h1>{{ title }}</h1>
<p class="subtitle">{{ author }}</p>
<div class="orn orn-d3b orn-title" aria-hidden="true"></div>
<div class="detail">
<div class="detail-cover">{{ cover(title, author, fo.tone, "lg") }}</div>
<div class="detail-info">
<dl>
<dt>Folder</dt><dd>{{ fo.title }}</dd>
<dt>Language</dt><dd>{{ language or "English" }}</dd>
<dt>Formats</dt><dd>{% for f in formats %}{{ f.name }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
{% if source %}<dt>Source</dt><dd>{% if source_url %}<a href="{{ source_url }}">{{ source }}</a>{% else %}{{ source }}{% endif %}</dd>{% endif %}
{% if terms %}<dt>Terms</dt><dd>{{ terms }}</dd>{% endif %}
</dl>
<p class="buttons">
{%- for f in formats %}
<a class="btn{% if hosted %} local{% endif %}" href="{% if hosted %}{{ f.url | url }}{% else %}{{ f.url }}{% endif %}">Download {{ f.name }}</a>
{%- endfor %}
</p>
{% if hosted %}
<p class="note-line">Hosted here with permission.{% if permission %} {{ permission }}{% endif %}</p>
{% else %}
<p class="note-line">This book is on the publisher's website. The button opens it there.</p>
{% endif %}
</div>
</div>
<p><a href="{{ '/resources/archive/' | url }}">← Back to the archive</a></p>
<div class="orn orn-o2 orn-end" aria-hidden="true"></div>
</div>
