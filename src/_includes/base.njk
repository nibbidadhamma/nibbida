{%- macro entry(i, page) -%}
{%- if i.ready -%}
<a href="{{ i.url | url }}"{% if i.url == page.url %} aria-current="page"{% endif %}>{{ i.title }}</a>
{%- else -%}
<span class="soon">{{ i.title }} <small>coming soon</small></span>
{%- endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="en" style="--field:2350px;--x:-125px;--y:-775px;--mx:-650px;--my:-900px;">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
{% if env.noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<script>try{var t=localStorage.getItem("nibbida-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
<link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/icons/favicon-32.png' | url }}">
<link rel="icon" type="image/png" sizes="192x192" href="{{ '/assets/icons/icon-192.png' | url }}">
<link rel="apple-touch-icon" href="{{ '/assets/icons/apple-touch-icon.png' | url }}">
<link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/readable.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/theme.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/menu.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/pages.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/archive.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/start.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/show.css' | url }}">
{%- for c in extra_css %}
<link rel="stylesheet" href="{{ c | url }}">
{%- endfor %}
<script src="{{ '/assets/menu.js' | url }}" defer></script>
<script src="{{ '/assets/theme.js' | url }}" defer></script>
<script src="{{ '/assets/passages.js' | url }}" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="site A{% if plain %} plain{% endif %}" id="top">
<header class="header">
<a class="brand" href="{{ '/' | url }}"><img class="logo-dark" src="{{ '/assets/emblem-A.svg' | url }}" alt=""><img class="logo-light" src="{{ '/assets/emblem-A-light.svg' | url }}" alt=""><span>{{ site.name }}</span></a>
<nav class="desk" aria-label="Main">
<a href="{{ '/resources/archive/' | url }}"{% if page.url == '/resources/archive/' %} aria-current="page"{% endif %}>Books</a>
<details class="drop"><summary>Resources</summary>
<div class="panel">
{{ entry({title: site.overview.title, url: site.overview.url, ready: true}, page) }}
{%- for r in site.resources %}
{{ entry(r, page) }}
{%- endfor %}
</div></details>
<a href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
<button type="button" class="theme-btn" hidden>Dark</button>
</nav>
<details class="menu"><summary>Menu</summary>
<div class="panel" role="navigation" aria-label="Main">
<a class="main-link" href="{{ '/resources/archive/' | url }}"{% if page.url == '/resources/archive/' %} aria-current="page"{% endif %}>Books</a>
<a class="main-link" href="{{ site.overview.url | url }}"{% if site.overview.url == page.url %} aria-current="page"{% endif %}>Resources</a>
<div class="sub">
{%- for r in site.resources %}
{{ entry(r, page) }}
{%- endfor %}
</div>
<a class="main-link" href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
<button type="button" class="theme-btn" hidden>Dark</button>
</div></details>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="footer" id="about">
{{ "C4-B" | ornament("orn-c4b footer-orn") | safe }}
<p>{{ site.name }}<br>{{ site.tagline }}</p>
<div class="footer-links">
{%- for f in site.footer %}
{{ entry(f, page) }}
{%- endfor %}
</div>
<a href="#top">Back to the beginning ↑</a>
</footer>
</div>
{%- for j in extra_js %}
<script src="{{ j | url }}" defer></script>
{%- endfor %}
</body>
</html>
