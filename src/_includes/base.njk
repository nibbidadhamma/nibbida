{%- macro entry(i, page) -%}
{%- if i.ready -%}
<a href="{{ i.url | url }}"{% if i.url == page.url %} aria-current="page"{% endif %}>{{ i.title }}</a>
{%- else -%}
<span class="soon">{{ i.title }} <small>coming soon</small></span>
{%- endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="en" style="--field:2350px;--x:-125px;--y:-775px;--mx:-650px;--my:-900px;">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
{% if env.noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<script>try{var t=localStorage.getItem("nibbida-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
<link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/icons/favicon-32.png' | url }}">
<link rel="icon" type="image/png" sizes="192x192" href="{{ '/assets/icons/icon-192.png' | url }}">
<link rel="apple-touch-icon" href="{{ '/assets/icons/apple-touch-icon.png' | url }}">
<link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/readable.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/theme.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/menu.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/pages.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/archive.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/start.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/show.css' | url }}">
<script src="{{ '/assets/menu.js' | url }}" defer></script>
<script src="{{ '/assets/theme.js' | url }}" defer></script>
<script src="{{ '/assets/passages.js' | url }}" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
