<div class="site A{% if plain %} plain{% endif %}" id="top">
<header class="header">
<a class="brand" href="{{ '/' | url }}"><img class="logo-dark" src="{{ '/assets/emblem-A.svg' | url }}" alt=""><img class="logo-light" src="{{ '/assets/emblem-A-light.svg' | url }}" alt=""><span>{{ site.name }}</span></a>
<nav class="desk" aria-label="Main">
<a href="{{ '/' | url }}#books">Books</a>
<details class="drop"><summary>Resources</summary>
<div class="panel">
{{ entry({title: site.overview.title, url: site.overview.url, ready: true}, page) }}
{%- for r in site.resources %}
{{ entry(r, page) }}
{%- endfor %}
</div></details>
<a href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
<button type="button" class="theme-btn" hidden>Dark</button>
</nav>
<details class="menu"><summary>Menu</summary>
<div class="panel" role="navigation" aria-label="Main">
<a class="main-link" href="{{ '/' | url }}#books">Books</a>
<a class="main-link" href="{{ site.overview.url | url }}"{% if site.overview.url == page.url %} aria-current="page"{% endif %}>Resources</a>
<div class="sub">
{%- for r in site.resources %}
{{ entry(r, page) }}
{%- endfor %}
</div>
<a class="main-link" href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
<button type="button" class="theme-btn" hidden>Dark</button>
</div></details>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="footer" id="about">
{{ "C4-B" | ornament("orn-c4b footer-orn") | safe }}
<p>{{ site.name }}<br>{{ site.tagline }}</p>
<div class="footer-links">
{%- for f in site.footer %}
{{ entry(f, page) }}
{%- endfor %}
</div>
<a href="#top">Back to the beginning ↑</a>
</footer>
</div>
</body>
</html>
